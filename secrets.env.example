# Template for secrets.env (the real file is gitignored). Upload with: bash scripts/sync-secrets.sh
# One [section] per GitHub Environment. Add a new section to add a new environment.
# No quotes, no spaces around "=". Lines with an empty value are skipped.

# Repository-level fallback: used by any environment that doesn't define the same name itself
[shared]
WS_CODE=33
BONUS_AMOUNT=10
BOOKING_CODE_LENGTH=5

[qa]
API_BASE_URL=https://sports2-core.btobet.com
WS_URL=wss://sports2-core.btobet.com
PAM_URL=https://api-bo2.btobet.com
FE_URL=https://qa.btobet.net
API_KEY=
PAM_API_KEY=
TOKEN=
EXTERNAL_USER_ID=
USER=
PASSWORD=
AGENT_TOKEN=
AGENT_EXTERNAL_USER_ID=
# optional, only for the bonus scenarios
BONUS_INSTANCE_ID=

[bsport]
API_BASE_URL=
WS_URL=
PAM_URL=
FE_URL=
API_KEY=
PAM_API_KEY=
TOKEN=
EXTERNAL_USER_ID=
USER=
PASSWORD=
AGENT_TOKEN=
AGENT_EXTERNAL_USER_ID=
BONUS_INSTANCE_ID=
